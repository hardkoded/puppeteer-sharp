---
import Landing from "../layouts/Landing.astro";
import sponsors from "../data/sponsors.json";
import contributors from "../data/contributors.json";

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
const sponsorUrl = "https://github.com/sponsors/hardkoded";
const repo = "https://github.com/hardkoded/puppeteer-sharp";

const description =
    "Puppeteer Sharp is built by people who love open source. Meet the sponsors and contributors, and become a sponsor.";

const featuredLogins = new Set(sponsors.featured.map((s) => s.login.toLowerCase()));
const people = sponsors.github.filter((s) => !featuredLogins.has(s.login.toLowerCase()));
const avatar = (login: string, size = 128) => `https://avatars.githubusercontent.com/${login}?s=${size}`;
---

<Landing title="Sponsors · Puppeteer Sharp" description={description} path="sponsors/">
    <section class="hero sponsors-hero" aria-labelledby="sponsors-title">
        <div class="wrap">
            <p class="eyebrow">Sponsors and contributors</p>
            <h1 id="sponsors-title">We love people who love OSS.</h1>
            <p class="lede">
                We want to thank everyone who contributes to open source. Whether it is one dollar, one software license, a thousand dollars, or a pull request at midnight: it keeps Puppeteer Sharp alive.
            </p>
            <div class="hero-actions">
                <a class="button button-primary" href={sponsorUrl}>
                    Become a sponsor
                    <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M12 20s-7-4.4-7-9.1C5 8 6.8 6.2 9.2 6.2c1.3 0 2.4.6 2.8 1.6.4-1 1.5-1.6 2.8-1.6C17.2 6.2 19 8 19 10.9 19 15.6 12 20 12 20Z"></path>
                    </svg>
                </a>
                <a class="button button-ghost" href={repo}>Contribute on GitHub</a>
            </div>
        </div>
    </section>

    <section class="section" aria-labelledby="supporters-title">
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Supporters</p>
                <h2 id="supporters-title">Companies backing the project.</h2>
                <p class="lede">Their money and licenses pay for CI, tooling, and the hours behind every release.</p>
            </div>
            <ul class="sponsor-cards">
                {sponsors.featured.map((s) => (
                    <li class="sponsor-card">
                        <a class="sponsor-card-link" href={s.url} rel="sponsored noopener">
                            {s.logo ? (
                                <img class="sponsor-logo" src={/^https?:/.test(s.logo) ? s.logo : href(s.logo)} alt={`${s.name} logo`} width="64" height="64" loading="lazy" />
                            ) : (
                                <span class="sponsor-logo sponsor-monogram" aria-hidden="true">{s.name.slice(0, 2)}</span>
                            )}
                            <h3>{s.name}</h3>
                            <p>{s.blurb}</p>
                            <span class="more">Visit {s.name}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    {people.length > 0 && (
        <section class="section sponsors-people" aria-labelledby="people-title">
            <div class="wrap">
                <div class="section-head">
                    <p class="eyebrow">GitHub Sponsors</p>
                    <h2 id="people-title">Thank you, every single one of you.</h2>
                </div>
                <ul class="avatar-grid avatar-grid-lg">
                    {people.map((p) => (
                        <li>
                            <a href={p.url} title={p.name}>
                                <img src={avatar(p.login, 160)} alt="" width="80" height="80" loading="lazy" />
                                <span>{p.name}</span>
                            </a>
                        </li>
                    ))}
                </ul>
            </div>
        </section>
    )}

    <section class="section" aria-labelledby="contributors-title">
        <div class="wrap">
            <div class="section-head">
                <p class="eyebrow">Contributors</p>
                <h2 id="contributors-title">{contributors.length} people who wrote the code.</h2>
                <p class="lede">Bug fixes, ports, docs, and reviews. Ordered by number of commits.</p>
            </div>
            <ul class="avatar-grid">
                {contributors.map((c) => (
                    <li>
                        <a href={c.url} title={`${c.login}: ${c.contributions} contributions`}>
                            <img src={avatar(c.login, 96)} alt="" width="48" height="48" loading="lazy" />
                            <span>{c.login}</span>
                        </a>
                    </li>
                ))}
            </ul>
        </div>
    </section>

    <section class="section cta-section" aria-labelledby="cta-title">
        <div class="wrap">
            <div class="cta-card">
                <h2 id="cta-title">Your name could be on this wall.</h2>
                <p>
                    Puppeteer Sharp is MIT licensed and free. Sponsoring pays for maintenance, new browser support, and faster issue triage. Companies get their logo here and in the README.
                </p>
                <a class="button button-primary" href={sponsorUrl}>
                    Become a sponsor
                    <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 8h10M9 4l4 4-4 4"></path>
                    </svg>
                </a>
            </div>
        </div>
    </section>
</Landing>
