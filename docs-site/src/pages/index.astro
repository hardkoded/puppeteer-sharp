---
import "@fontsource-variable/figtree/wght.css";
import "@fontsource/dm-mono/latin-400.css";
import "@fontsource/dm-mono/latin-500.css";
import logo from "../assets/logo.png";
import { siteOrigin } from "../../site.mjs";
import "../styles/landing.css";

const base = import.meta.env.BASE_URL;
const href = (path: string) => `${base}${path.replace(/^\//, "")}`;
const canonical = new URL(base, siteOrigin).href;
const repo = "https://github.com/hardkoded/puppeteer-sharp";
const sponsor = "https://github.com/sponsors/hardkoded";
const nuget = "https://www.nuget.org/packages/PuppeteerSharp/";
const install = "dotnet add package PuppeteerSharp";

const description =
    "Puppeteer Sharp is a .NET port of the Node.js Puppeteer API. Launch Chrome or Firefox and drive the page from C#.";

// Quick start from docfx_project/index.md. The line break is only so LaunchAsync fits the card.
const sampleHtml = [
    `<span class="k">using var</span> browser = <span class="k">await</span> Puppeteer.<span class="f">LaunchAsync</span>(`,
    `    <span class="k">new</span> <span class="t">LaunchOptions</span> { Headless = <span class="k">true</span> });`,
    `<span class="k">var</span> page = <span class="k">await</span> browser.<span class="f">NewPageAsync</span>();`,
    `<span class="k">await</span> page.<span class="f">GoToAsync</span>(<span class="s">"https://example.com"</span>);`,
    `<span class="k">await</span> page.<span class="f">ScreenshotAsync</span>(<span class="s">"screenshot.png"</span>);`,
].join("\n");

const locatorSample = `await page.Locator("button.submit")
    .SetWaitForEnabled(true)
    .SetEnsureElementIsInTheViewport(true)
    .ClickAsync();`;
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width, initial-scale=1" />
        <title>Puppeteer Sharp</title>
        <meta name="description" content={description} />
        <meta name="theme-color" content="#071311" />
        <link rel="canonical" href={canonical} />
        <link rel="icon" href={href("favicon.png")} />
        <meta property="og:title" content="Puppeteer Sharp" />
        <meta property="og:description" content={description} />
        <meta property="og:url" content={canonical} />
        <meta property="og:type" content="website" />
    </head>
    <body>
        <a class="skip" href="#content">Skip to content</a>
        <header class="nav">
            <div class="wrap nav-inner">
                <div class="nav-start">
                    <a class="brand" href={base}>
                        <img src={logo.src} width={logo.width} height={logo.height} alt="" />
                        <span>Puppeteer Sharp</span>
                    </a>
                    <a class="nav-docs" href={href("docs/")}>Docs</a>
                </div>
                <div class="nav-links">
                    <a class="icon-button" href={repo} aria-label="Puppeteer Sharp on GitHub">
                        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                            <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82a7.7 7.7 0 0 1 2-.27c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"></path>
                        </svg>
                    </a>
                    <a class="button button-ghost" href={sponsor}>
                        <svg viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M12 20s-7-4.4-7-9.1C5 8 6.8 6.2 9.2 6.2c1.3 0 2.4.6 2.8 1.6.4-1 1.5-1.6 2.8-1.6C17.2 6.2 19 8 19 10.9 19 15.6 12 20 12 20Z"></path>
                        </svg>
                        Sponsor
                    </a>
                </div>
                <a class="button button-primary nav-cta" href={href("docs/")}>
                    Get started
                    <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M3 8h10M9 4l4 4-4 4"></path>
                    </svg>
                </a>
            </div>
        </header>

        <main id="content">
            <section class="hero" aria-labelledby="hero-title">
                <svg class="hero-art" viewBox="0 0 1400 780" preserveAspectRatio="xMidYMid slice" aria-hidden="true">
                    <g fill="none" stroke="currentColor" stroke-width="1.25" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M0 168h84l28 28h48"></path>
                        <path d="M0 592h72l40-40h52"></path>
                        <path d="M1224 112h72l44 44h60"></path>
                        <path d="M1216 668h80l32-32h72"></path>
                    </g>
                    <g fill="none" stroke="currentColor" stroke-width="1.25">
                        <circle cx="0" cy="168" r="5"></circle>
                        <circle cx="160" cy="196" r="5"></circle>
                        <circle cx="0" cy="592" r="5"></circle>
                        <circle cx="164" cy="552" r="5"></circle>
                        <circle cx="1224" cy="112" r="5"></circle>
                        <circle cx="1400" cy="156" r="5"></circle>
                        <circle cx="1216" cy="668" r="5"></circle>
                        <circle cx="1400" cy="636" r="5"></circle>
                    </g>
                </svg>
                <div class="wrap hero-grid">
                    <div>
                        <p class="eyebrow">Puppeteer Sharp</p>
                        <h1 id="hero-title">Drive the browser from C#.</h1>
                        <p class="lede">
                            A .NET port of the <a href="https://github.com/puppeteer/puppeteer">Node.js Puppeteer API</a>.
                            Launch Chrome or Firefox, open a page, and click, type, screenshot, or print a PDF.
                        </p>
                        <div class="hero-actions">
                            <a class="button button-primary" href={href("docs/")}>
                                Get started
                                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M3 8h10M9 4l4 4-4 4"></path>
                                </svg>
                            </a>
                            <a class="button button-ghost" href={repo}>
                                <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor">
                                    <path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.75.75 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"></path>
                                </svg>
                                Star on GitHub
                            </a>
                        </div>
                        <div class="install">
                            <span class="prompt" aria-hidden="true">$</span>
                            <code>{install}</code>
                            <button type="button" class="copy" data-copy={install} aria-live="polite">Copy</button>
                        </div>
                        <p class="install-note">
                            The package targets <code>netstandard2.0</code>, <code>net8.0</code>, and <code>net10.0</code>.
                            <a href={nuget}>PuppeteerSharp on NuGet</a>.
                        </p>
                    </div>

                    <figure class="code-card">
                        <figcaption class="code-bar">
                            <span class="code-file">
                                <span class="lang-badge">C#</span>
                                Quick start
                            </span>
                            <span class="code-status">
                                <span class="live-dot" aria-hidden="true"></span>
                                <a href={href("docs/#quick-start")}>Docs quick start</a>
                            </span>
                        </figcaption>
                        <pre><code set:html={sampleHtml} /></pre>
                        <div class="code-foot">
                            <span>LaunchOptions.Browser defaults to Chrome</span>
                        </div>
                    </figure>
                </div>
            </section>

            <section class="band" aria-label="Project facts">
                <div class="wrap band-grid">
                    <div class="band-item">
                        <p class="band-kicker">Package</p>
                        <h2><a href={nuget}>PuppeteerSharp</a></h2>
                        <p>NuGet package id</p>
                    </div>
                    <div class="band-item">
                        <p class="band-kicker">Targets</p>
                        <h2>netstandard2.0</h2>
                        <p>Plus net8.0 and net10.0</p>
                    </div>
                    <div class="band-item">
                        <p class="band-kicker">Browsers</p>
                        <h2>Chrome</h2>
                        <p>And Firefox, headless or headful</p>
                    </div>
                    <div class="band-item">
                        <p class="band-kicker">License</p>
                        <h2>MIT</h2>
                        <p>Free for commercial use</p>
                    </div>
                </div>
            </section>

            <section class="section" aria-labelledby="features-title">
                <div class="wrap">
                    <div class="section-head">
                        <p class="eyebrow">Why Puppeteer Sharp</p>
                        <h2 id="features-title">The Puppeteer API, on the runtimes you already ship.</h2>
                        <p class="lede">
                            Navigation, input, network interception, screenshots, and PDFs. Headless or headful, on Windows, macOS, and Linux.
                        </p>
                    </div>
                    <ul class="features">
                        <li class="feature">
                            <span class="feature-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="18" height="16" rx="2"></rect>
                                    <path d="M3 9h18M8 6.5h.01M11 6.5h.01"></path>
                                </svg>
                            </span>
                            <h3>Chrome and Firefox</h3>
                            <p>
                                Launch a browser, open a page, and drive navigation, input, and network interception. Headless and headful both work.
                            </p>
                            <a class="more" href={href("docs/#browser-automation")}>
                                Browser automation
                                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                            </a>
                        </li>
                        <li class="feature">
                            <span class="feature-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="5" width="18" height="14" rx="2"></rect>
                                    <circle cx="9" cy="10" r="1.5"></circle>
                                    <path d="M21 15.5l-4.5-4.5L7 19"></path>
                                </svg>
                            </span>
                            <h3>Screenshots and PDFs</h3>
                            <p>
                                <code>ScreenshotAsync</code> writes a file. Full-page capture, custom viewports, and clipping are in the screenshot guide. <code>PdfAsync</code> prints the page.
                            </p>
                            <a class="more" href={href("docs/Page.ScreenshotAsync/")}>
                                Take a screenshot
                                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                            </a>
                        </li>
                        <li class="feature">
                            <span class="feature-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <circle cx="12" cy="12" r="6"></circle>
                                    <path d="M12 2v4M12 18v4M2 12h4M18 12h4"></path>
                                </svg>
                            </span>
                            <h3>Locators that wait</h3>
                            <p>
                                <code>Page.Locator</code> re-finds the element on every action and retries until it is visible, enabled, and in view.
                            </p>
                            <a class="more" href={href("docs/Locators/")}>
                                Locators guide
                                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                            </a>
                        </li>
                        <li class="feature">
                            <span class="feature-icon" aria-hidden="true">
                                <svg viewBox="0 0 24 24">
                                    <rect x="3" y="4" width="7" height="7" rx="1.5"></rect>
                                    <rect x="14" y="13" width="7" height="7" rx="1.5"></rect>
                                    <path d="M10 7.5h3a4 4 0 0 1 4 4V13"></path>
                                </svg>
                            </span>
                            <h3>CDP and WebDriver BiDi</h3>
                            <p>
                                Chrome DevTools Protocol and WebDriver BiDi are both first-class. Pick the protocol that fits the browser.
                            </p>
                            <a class="more" href={href("docs/#dual-protocol-support")}>
                                Dual protocol
                                <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                            </a>
                        </li>
                    </ul>
                </div>
            </section>

            <section class="section steps-section" aria-labelledby="steps-title">
                <div class="wrap steps-layout">
                    <div class="steps-copy">
                        <p class="eyebrow">Get started</p>
                        <h2 id="steps-title">From an empty project to a screenshot, in three steps.</h2>
                        <p class="lede">
                            Install the package, open a page, then screenshot it or click with a locator. Each step links to the page that has the rest.
                        </p>
                        <a class="button button-primary" href={href("docs/")}>
                            Read the docs
                            <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M3 8h10M9 4l4 4-4 4"></path>
                            </svg>
                        </a>
                    </div>
                    <ol class="steps">
                        <li class="step">
                            <span class="step-index" aria-hidden="true"></span>
                            <div>
                                <h3>Install the package</h3>
                                <p>Add <code>PuppeteerSharp</code>. It targets <code>netstandard2.0</code>, <code>net8.0</code>, and <code>net10.0</code>.</p>
                                <pre class="chip"><code>{install}</code></pre>
                                <a class="more" href={href("docs/#quick-start")}>
                                    Quick start
                                    <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                                </a>
                            </div>
                        </li>
                        <li class="step">
                            <span class="step-index" aria-hidden="true"></span>
                            <div>
                                <h3>Open a page and save a screenshot</h3>
                                <p><code>LaunchAsync</code> starts Chrome. <code>GoToAsync</code> loads the URL. <code>ScreenshotAsync</code> writes the file.</p>
                                <pre class="chip"><code>await page.GoToAsync("https://example.com");
await page.ScreenshotAsync("screenshot.png");</code></pre>
                                <a class="more" href={href("docs/Page.ScreenshotAsync/")}>
                                    Screenshot guide
                                    <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                                </a>
                            </div>
                        </li>
                        <li class="step">
                            <span class="step-index" aria-hidden="true"></span>
                            <div>
                                <h3>Click with a locator</h3>
                                <p>A locator waits until the element is enabled and in the viewport, then clicks it.</p>
                                <pre class="chip"><code>{locatorSample}</code></pre>
                                <a class="more" href={href("docs/Locators/")}>
                                    Locators guide
                                    <svg viewBox="0 0 16 16" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M3 8h10M9 4l4 4-4 4"></path></svg>
                                </a>
                            </div>
                        </li>
                    </ol>
                </div>
            </section>
        </main>

        <footer class="footer">
            <div class="wrap">
                <p><strong>Puppeteer Sharp</strong></p>
                <p>
                    .NET port of the Node.js Puppeteer API.
                    MIT license.
                </p>
                <nav class="footer-links" aria-label="Footer">
                    <a href={href("docs/")}>Docs</a>
                    <a href={href("docs/examples/")}>Examples</a>
                    <a href={href("docs/Locators/")}>Locators</a>
                    <a href={href("api/")}>API</a>
                    <a href={repo}>GitHub</a>
                    <a href={nuget}>NuGet</a>
                    <a href={sponsor}>Sponsor</a>
                </nav>
            </div>
        </footer>
        <script>
            import "../scripts/landing-copy.js";
        </script>
    </body>
</html>
